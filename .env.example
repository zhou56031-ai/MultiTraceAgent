# 公开模板：复制为 .env 后只在本机填写真实值。
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=replace_with_your_model_api_key
LLM_QWEN_MAX=replace_with_a_model_available_to_your_account
TAVILY_API_KEY=replace_with_your_tavily_api_key

# 可选：MySQL只读练习账号。留空时不启用数据库助手。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 可选：已有RAGFlow服务和聊天助手；留空时不启用知识库助手。
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# 可选：后续Embedding扩展使用；当前读取/来源/恢复功能不调用Embedding。
DASHSCOPE_API_KEY=
